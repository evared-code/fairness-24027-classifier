<mxfile host="drawio" agent="TR24027 generator"><diagram name="qoc-c3" id="qoc-c3"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="o0" value="&lt;i&gt;«design solution»&lt;/i&gt;&lt;br&gt;Prioritize data privacy from the outset by&lt;br&gt;implementing best practices in data encryption,&lt;br&gt;anonymization, and secure data storage" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="330" height="90" as="geometry"/></mxCell><mxCell id="o1" value="&lt;i&gt;«design solution»&lt;/i&gt;&lt;br&gt;Create and adhere to a well-defined ethical AI&lt;br&gt;framework to guide the development and deployment of&lt;br&gt;AI solutions" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="164" width="330" height="90" as="geometry"/></mxCell><mxCell id="o2" value="&lt;i&gt;«design solution»&lt;/i&gt;&lt;br&gt;Invest in a scalable and robust data infrastructure&lt;br&gt;with secure data management practices" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="268" width="330" height="74" as="geometry"/></mxCell><mxCell id="o3" value="&lt;i&gt;«design solution»&lt;/i&gt;&lt;br&gt;Conduct regular audits and assessments of AI systems&lt;br&gt;to ensure compliance with privacy regulations" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="